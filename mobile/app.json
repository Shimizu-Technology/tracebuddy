{
  "expo": {
    "name": "TraceBuddy",
    "slug": "tracebuddy-mobile",
    "version": "2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tracebuddy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shimizutechnology.tracebuddy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "com.shimizutechnology.tracebuddy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C2E4FF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Use your camera to trace on paper and take a photo of your finished drawing.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo from your library to use in a drawing.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save a copy of your drawing to your photo library when you tap Save to Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FFF7EA"
        }
      ],
      "expo-sharing",
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "owner": "shimizutechnology",
    "extra": {
      "eas": {
        "projectId": "32bf20c8-1faf-4333-966a-f046461e7f48"
      }
    }
  }
}
