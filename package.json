{
  "name": "tracebuddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check": "npm run art:check && npm run glyphs:check && npm run check:text-guide && npm run check:picture-line-model && npm run check:picture-sections && npm run lint && npm run build && npm run check:finish-find-model && npm run check:practice-model && npm run check:discovery-model && npm run check:learning-model && npm run check:drawing-lessons && npm run check:setup-model && npm run check:family-model && npm run check:mobile-print && npm run check:ar-model && npm run check:paper-model && npm run check:native-practice-model && npm run check:native-practice-operations && npm run check:native-safety-model && npm run check:native-finish-find-model && npm run check:native-storage-model && npm run check:audit-model && npm run check:contrast && npm run mobile:typecheck && npm run mobile:doctor",
    "check:viewports": "node scripts/viewport-check.mjs",
    "check:storage": "node scripts/storage-check.mjs",
    "check:offline": "node scripts/offline-check.mjs",
    "check:discovery": "node scripts/discovery-check.mjs",
    "check:discovery-model": "tsx scripts/discovery-model-check.ts",
    "check:learning": "node scripts/learning-check.mjs",
    "check:learning-model": "tsx scripts/learning-model-check.ts",
    "check:setup": "node scripts/setup-check.mjs",
    "check:setup-model": "tsx scripts/setup-model-check.ts",
    "check:family": "node scripts/family-check.mjs",
    "check:navigation": "node scripts/navigation-check.mjs",
    "check:family-model": "tsx scripts/family-model-check.ts",
    "check:mobile-print": "tsx scripts/mobile-print-check.ts",
    "check:ar-model": "tsx scripts/ar-trace-model-check.ts",
    "check:paper-model": "tsx scripts/paper-model-check.ts && tsx scripts/paper-motion-check.ts && tsx scripts/paper-session-check.ts && tsx scripts/paper-navigation-check.ts && tsx scripts/paper-hook-check.ts",
    "drawings:validate": "tsx scripts/validate-drawings.ts",
    "drawings:contact-sheets": "tsx scripts/generate-drawing-contact-sheets.ts",
    "audit:check": "node scripts/audit-check.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "preview": "vite preview",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:doctor": "npm --prefix mobile run doctor",
    "check:native-practice-model": "tsx scripts/native-practice-model-check.ts && tsx scripts/coloring-tools-check.ts",
    "check:audit-model": "node scripts/audit-model-check.mjs",
    "check:native-practice-operations": "tsx scripts/native-practice-operations-check.ts",
    "check:practice-model": "tsx scripts/practice-model-check.ts",
    "check:practice": "node scripts/practice-check.mjs && node scripts/practice-regression-check.mjs",
    "check:surfaces": "node scripts/surfaces-check.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:web-round2": "node scripts/web-round2-check.mjs",
    "check:native-safety-model": "tsx scripts/native-safety-model-check.ts",
    "check:finish-find-model": "tsx scripts/finish-find-model-check.ts && tsx scripts/finish-find-save-model-check.ts",
    "check:finish-find": "node scripts/finish-find-check.mjs",
    "check:native-finish-find-model": "tsx scripts/native-finish-find-model-check.ts",
    "check:native-storage-model": "tsx scripts/native-storage-model-check.ts",
    "art:generate": "tsx scripts/generate-art-index.ts",
    "art:check": "tsx scripts/generate-art-index.ts --check",
    "art:optimize": "tsx scripts/optimize-line-art.ts && npm run art:generate",
    "check:picture-line-model": "tsx scripts/picture-line-model-check.ts",
    "check:picture-sections": "tsx scripts/picture-sections-check.ts",
    "glyphs:generate": "tsx scripts/generate-glyphs.ts",
    "glyphs:check": "tsx scripts/generate-glyphs.ts --check",
    "check:text-guide": "tsx scripts/text-guide-check.ts",
    "check:drawing-lessons": "tsx scripts/drawing-lessons-check.ts"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/opentype.js": "1.3.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "opentype.js": "2.0.0",
    "playwright": "^1.64.1",
    "puppeteer-core": "^25.1.0",
    "svgo": "4.1.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
